# Create a Modal Secret named ukb-kg-service using the dashboard.
UKB_SERVICE_TOKEN=REPLACE_WITH_THE_SAME_RANDOM_TOKEN_AS_STREAMLIT
UKB_NEO4J_URI=neo4j+s://REPLACE_INSTANCE.databases.neo4j.io
UKB_NEO4J_USER=neo4j
UKB_NEO4J_PASSWORD=REPLACE_WITH_AURA_PASSWORD
UKB_NEO4J_DATABASE=neo4j
UKB_RAG_ENABLED=true
UKB_EXPORT_ENABLED=false
